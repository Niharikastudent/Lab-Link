# =====================================================================
# LABLINK ENVIRONMENT VARIABLES TEMPLATE
# =====================================================================

# 1. Supabase PostgreSQL Configuration (Optional for offline demo evaluation)
# When set, LabLink automatically synchronizes with Supabase.
# When omitted, LabLink functions seamlessly in Local Demonstration Store mode.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Administrative Security Passcode for Faculty Operations
# Used to verify faculty approval, rejection, and issue/return checkouts.
# Default demo credential if left unset: LabLink2026!
VITE_FACULTY_PASSCODE=LabLink2026!
